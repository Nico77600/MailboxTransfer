<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mailbox Transfer" Width="1480" Height="940" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <!-- House style of Mailbox Message Report (cards on a flat page, 24 px margins, 12 px between cards). Colours come from the Fluent theme
         resources and from the keys set by Set-MbtGuiTheme (MbtBrand, MbtSuccess...). -->
    <Style x:Key="MbtCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18,14,18,16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="MbtCardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="MbtLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style x:Key="MbtHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="MbtIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    </Style>
    <Style x:Key="MbtRow" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0,1"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>

    <!-- A link: accent text, underlined. -->
    <Style x:Key="MbtLink" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextDecorations="Underline" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A task card (radio behaviour): a toggle button that looks like a card. -->
    <Style x:Key="MbtTaskCard" TargetType="ToggleButton">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Padding" Value="18,16"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource MbtAccentSoft}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                <Setter TargetName="B" Property="BorderThickness" Value="2"/>
                <Setter TargetName="B" Property="Padding" Value="17,15"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A clickable row (step, folder of a run): transparent, soft accent when selected. -->
    <Style x:Key="MbtPick" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource MbtAccentSoft}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A step of the stepper: round number and label. -->
    <Style x:Key="MbtSeg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="6" BorderThickness="1" Padding="12,5" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource MbtBrandText}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource MbtAccentSoft}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource MbtBrand}"/>
                <Setter Property="Foreground" Value="{DynamicResource MbtBrandText}"/><Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>    <Style x:Key="MbtStepButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Padding" Value="4,4,10,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Expander used for "More options": a link-like header, a thin rule above. -->
    <Style x:Key="MbtMore" TargetType="Expander">
      <Setter Property="Margin" Value="0,10,0,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Folder tree: tri-state box, glyph, name, count, size. -->
    <HierarchicalDataTemplate x:Key="MbtFolderTemplate" ItemsSource="{Binding Children}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding Check, Mode=TwoWay}" MinWidth="0" Padding="0" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding CheckVisibility}"
                  AutomationProperties.Name="Select folder"/>
        <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,2,7,0" Foreground="{DynamicResource MbtBrandText}"/>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock x:Name="NodeName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
          <TextBlock Text="{Binding Sub}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding SubVisibility}"/>
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding CountText}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource MbtBrandText}"/>
        <TextBlock Grid.Column="4" Text="{Binding SizeText}" Margin="8,0,0,0" FontSize="12" MinWidth="54" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </Grid>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding Dim}" Value="True">
          <Setter TargetName="NodeName" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <Grid x:Name="Root" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid x:Name="Header" Margin="24,18,24,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Width="46" Height="46" CornerRadius="10" Background="{DynamicResource MbtBrand}" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource MbtIcon}" Text="&#xE715;" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="EXCHANGE ONLINE MAILBOX EXPORT, IMPORT AND PST" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MbtBrandText}"/>
        <TextBlock Text="MailboxTransfer" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                   Text="Move mail between mailboxes, export stores and PST files. The console tells you what to do next."/>
      </StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <RadioButton x:Name="Th_System" GroupName="Theme" Style="{StaticResource MbtSeg}" Content="System" AutomationProperties.Name="Theme: like Windows"/>
          <RadioButton x:Name="Th_Light" GroupName="Theme" Style="{StaticResource MbtSeg}" Content="Light" AutomationProperties.Name="Theme: light"/>
          <RadioButton x:Name="Th_Dark" GroupName="Theme" Style="{StaticResource MbtSeg}" Content="Dark" Margin="0" AutomationProperties.Name="Theme: dark"/>
        </StackPanel>
        <TextBlock x:Name="Version" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
          <Button x:Name="HelpGuide" Style="{StaticResource MbtLink}" Content="User guide" FontSize="12" Margin="0,0,12,0" AutomationProperties.Name="Open the user guide"/>
          <Button x:Name="HelpRelease" Style="{StaticResource MbtLink}" Content="Latest release" FontSize="12" AutomationProperties.Name="Open the page of the latest release on GitHub"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Border x:Name="StepperCard" Grid.Row="1" Margin="24,0,24,12" Padding="10,6" CornerRadius="24" BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="Stepper" Orientation="Horizontal" VerticalAlignment="Center"/>
        <TextBlock x:Name="StepperContext" Grid.Column="1" FontSize="12" Margin="8,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </Grid>
    </Border>

    <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,0">
      <ContentControl x:Name="Page" IsTabStop="False"/>
    </ScrollViewer>

    <Border x:Name="Actions" Grid.Row="3" Padding="24,12" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="{DynamicResource LayerFillColorDefaultBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Content="Back" MinWidth="80" Margin="0,0,8,0"/>
        <ContentControl x:Name="ActionsLeft" Grid.Column="1" IsTabStop="False"/>
        <TextBlock x:Name="Footer" Grid.Column="2" Margin="8,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <ContentControl x:Name="ActionsExtra" Grid.Column="3" IsTabStop="False" Margin="0,0,8,0"/>
        <Button x:Name="Primary" Grid.Column="4" MinWidth="190" Padding="16,6">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="PrimaryIcon" Style="{StaticResource MbtIcon}" Margin="0,2,8,0" Visibility="Collapsed"/>
            <TextBlock x:Name="PrimaryLabel" Text="Continue"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Dialog layer: a scrim and a card, the console's own (no system message boxes). -->
    <Grid x:Name="Overlay" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource MbtScrim}">
      <Border x:Name="DialogCard" Style="{StaticResource MbtCard}" Width="640" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0" Padding="22,18,22,18">
        <StackPanel>
          <TextBlock x:Name="DialogTitle" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
          <ContentControl x:Name="DialogBody" Margin="0,8,0,0" IsTabStop="False"/>
          <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
