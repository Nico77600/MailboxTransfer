# Language statistics: the guides are documentation, not code.
package/docs/** linguist-documentation

* text=auto

# Binary payloads: exported FastTransfer streams and managed or native libraries.
*.fxs -text
*.dll -text
*.sqlite -text

# Signed and hashed package files are byte-exact: no end-of-line conversion, so the Authenticode signatures and the SHA256 of PackageIntegrity.psd1 stay valid.
# Do not add a global autocrlf rule for these paths. Everything under package/ is hashed (except the editable configuration); the signed files are listed one by one.
package/** -text whitespace=blank-at-eol,space-before-tab,blank-at-eof,cr-at-eol
CHANGELOG.md -text whitespace=blank-at-eol,space-before-tab,blank-at-eof,cr-at-eol
SECURITY.md -text whitespace=blank-at-eol,space-before-tab,blank-at-eof,cr-at-eol

# Owner-signed files (the PowerShell files of the package, the module manifest included, and the inventory manifest); cr-at-eol because their working-tree line endings are CRLF.
package/Invoke-MailboxTransfer.ps1 -text whitespace=blank-at-eol,space-before-tab,blank-at-eof,cr-at-eol
